{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!web/static",
			"!web/build",
			"!web/.svelte-kit",
			"!**/*.md"
		]
	},
	"formatter": { "enabled": true },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		}
	]
}
