{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"predev": "pnpm sync-ort",
		"build": "vite build",
		"prebuild": "pnpm sync-ort",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --fail-on-warnings",
		"test": "vitest run",
		"e2e": "playwright test",
		"sync-ort": "mkdir -p static/ort && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.wasm node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.jsep.mjs node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.mjs static/ort/"
	},
	"dependencies": {
		"@techstark/opencv-js": "5.0.0-release.1",
		"heic-to": "1.6.7",
		"onnxruntime-web": "1.31.1"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.1"
	}
}
